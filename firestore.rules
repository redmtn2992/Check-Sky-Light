rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Community Sightings Collection
    match /sightings/{sightingId} {
      allow read: if true;
      allow create: if isValidId(sightingId) &&
        request.resource.data.keys().hasAll(['id', 'title', 'timestamp', 'deconflictionStatus']) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.deconflictionStatus is string && request.resource.data.deconflictionStatus.size() <= 50;
      allow update, delete: if isSignedIn();
    }

    // Diagnostics Collection
    match /diagnostics/{diagId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(diagId);
    }
  }
}
